{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "REDACT_GUARD_URL": "http://gateway:8787",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ANTHROPIC_BASE_URL": "http://gateway:8787",
    "OTEL_LOG_USER_PROMPTS": "0",
    "OTEL_LOG_TOOL_DETAILS": "0"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(psql *)",
      "Bash(pg_dump *)",
      "Bash(pg_dumpall *)",
      "Bash(pg_restore *)",
      "Bash(pgcli *)",
      "Bash(mysql *)",
      "Bash(mysqldump *)",
      "Bash(mysqlsh *)",
      "Bash(mariadb *)",
      "Bash(mycli *)",
      "Bash(mongo *)",
      "Bash(mongosh *)",
      "Bash(mongodump *)",
      "Bash(mongoexport *)",
      "Bash(redis-cli *)",
      "Bash(valkey-cli *)",
      "Bash(sqlite3 *)",
      "Bash(duckdb *)",
      "Bash(sqlcmd *)",
      "Bash(sqlplus *)",
      "Bash(cqlsh *)",
      "Bash(clickhouse-client *)",
      "Bash(influx *)",
      "Bash(cockroach *)",
      "Bash(usql *)",
      "Bash(etcdctl *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl port-forward *)",
      "Bash(kubectl cp *)",
      "Bash(kubectl get secret *)",
      "Bash(kubectl get secrets *)",
      "Bash(kubectl describe secret *)",
      "Bash(docker exec *)",
      "Bash(docker compose exec *)",
      "Bash(docker-compose exec *)",
      "Read(**/*.sqlite)",
      "Read(**/*.sqlite3)",
      "Read(**/*.db)",
      "Read(**/*.dump)",
      "Read(**/*.rdb)",
      "Read(**/*.duckdb)",
      "Read(~/.pgpass)",
      "Read(~/.my.cnf)",
      "Read(~/.mylogin.cnf)",
      "Read(~/.psql_history)",
      "Read(~/.mysql_history)",
      "Read(~/.config/redact-guard/**)",
      "Read(~/.local/share/redact-guard/**)",
      "Edit(~/.config/redact-guard/**)",
      "Edit(~/.local/share/redact-guard/**)",
      "Edit(~/.claude/settings.json)"
    ],
    "disableAutoMode": "disable"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /opt/redact-guard/hooks/guard.py prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /opt/redact-guard/hooks/guard.py pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": false
  },
  "allowedProviders": [
    "customEndpoint"
  ],
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true
}
