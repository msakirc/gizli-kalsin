FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      git python3 ca-certificates ripgrep less \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @anthropic-ai/claude-code \
 && useradd -m -u 10002 dev
# Hooks need the policy and health-proof modules only (no vault, no key).
COPY redact_guard/policy.py redact_guard/vault.py redact_guard/healthproof.py redact_guard/__init__.py /opt/redact-guard/redact_guard/
COPY hooks /opt/redact-guard/hooks
COPY container/claude-settings.json /etc/claude-code/managed-settings.json
COPY settings/CLAUDE.md.snippet /etc/claude-code/CLAUDE.md
USER dev
WORKDIR /workspace
CMD ["claude"]
